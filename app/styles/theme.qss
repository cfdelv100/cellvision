QMainWindow {
    background: #0f172a;
}

QWidget {
    font-family: "Segoe UI";
    font-size: 14px;
    color: #e2e8f0;
}

#Sidebar {
    background: #111827;
    border-right: 1px solid #1e293b;
}

#SidebarTitle {
    font-size: 24px;
    font-weight: 700;
}

#SidebarSubtitle {
    color: #94a3b8;
}

QListWidget {
    background: transparent;
    border: none;
    outline: none;
}

QListWidget::item {
    padding: 12px;
    border-radius: 8px;
    margin: 3px 0;
}

QListWidget::item:selected {
    background: #1e40af;
}

#ContentArea {
    background: #0f172a;
}

#PageTitle {
    font-size: 28px;
    font-weight: 700;
}

#PageSubtitle {
    color: #94a3b8;
}

#StatCard {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 12px;
}

#StatCardTitle {
    color: #94a3b8;
    font-size: 13px;
}

#StatCardValue {
    font-size: 30px;
    font-weight: 700;
}

#StatCardSubtitle {
    color: #64748b;
    font-size: 12px;
}

#StatusPanel {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 12px;
}

#SectionTitle {
    font-size: 17px;
    font-weight: 600;
}

QPushButton {
    background: #2563eb;
    border: none;
    border-radius: 8px;
    padding: 10px 18px;
    font-weight: 600;
}

QPushButton:hover {
    background: #1d4ed8;
}

QPushButton:pressed {
    background: #1e40af;
}